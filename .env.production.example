# ============================================================
# Production environment for self-hosted deployment (Coolify)
# Copy these into Coolify → Application → Environment Variables.
# Variables prefixed with VITE_ MUST be marked as "Build Variable"
# in Coolify because Vite inlines them at build time.
# ============================================================

# --- Supabase (self-hosted on the same server) ---
SUPABASE_URL=https://supabase.yourdomain.com
VITE_SUPABASE_URL=https://supabase.yourdomain.com

# Anon / publishable key — safe to expose to browser
SUPABASE_PUBLISHABLE_KEY=replace-with-anon-key-from-coolify
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-anon-key-from-coolify

# Service-role key — SERVER ONLY, bypasses RLS. NEVER expose with VITE_ prefix.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-coolify

# Project id label (only used for client/types)
VITE_SUPABASE_PROJECT_ID=self-hosted

# --- Lovable AI Gateway (only if you still use Lovable AI features) ---
# LOVABLE_API_KEY=

# --- Runtime ---
NODE_ENV=production
PORT=3000
HOST=0.0.0.0